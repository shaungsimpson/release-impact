{
    "name": "shaungsimpson/release-impact",
    "description": "A CLI for reviewing deployment-relevant changes in Laravel applications.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "ReleaseImpact\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --bootstrap vendor/autoload.php tests"
    },
    "bin": ["bin/release-impact"]
}
